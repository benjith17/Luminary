<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ViewModel"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="View.ConfigWindow"
        x:DataType="vm:FixturesListPanelViewModel"
        Icon="/Assets/icon.ico"
        Title="Patch"
        Width="920" Height="620"
        MinWidth="640" MinHeight="440"
        Background="{DynamicResource ThemeBg0}">

  <TabControl Padding="0" Margin="0">

    <!-- ============ Universes ============ -->
    <TabItem Header="Universes">
      <Grid ColumnDefinitions="250,*">

        <DockPanel Grid.Column="0" Background="{DynamicResource Panel-Bg}">
          <Border DockPanel.Dock="Bottom" Padding="8 6"
                  BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ThemeBorder0}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="themed" Content="+ Add" Command="{Binding AddUniverseCommand}" Padding="10 5" FontSize="12" />
              <Button Classes="themed" Content="Remove" Command="{Binding RemoveUniverseCommand}" Padding="10 5" FontSize="12" />
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Universes}" SelectedItem="{Binding SelectedUniverse}"
                   Background="Transparent" BorderThickness="0" Padding="0 4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:UniverseItemViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding Number, StringFormat='Universe {0}'}" FontSize="13" Foreground="{DynamicResource ThemeText0}" />
                  <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource ThemeText2}" Margin="0 2 0 0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1"
                      IsVisible="{Binding SelectedUniverse, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <StackPanel Margin="26 22" DataContext="{Binding SelectedUniverse}" x:DataType="vm:UniverseItemViewModel">
            <TextBlock Text="{Binding Number, StringFormat='Universe {0}'}" FontSize="16" Foreground="{DynamicResource ThemeText0}" />
            <TextBlock Text="512 channels" FontSize="12" Foreground="{DynamicResource ThemeText2}" Margin="0 4 0 22" />

            <Grid ColumnDefinitions="120,*" RowSpacing="14">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Output" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding OutputType}" FontSize="13" />
            </Grid>

            <StackPanel IsVisible="{Binding ShowUniverseSettings}">
              <TextBlock Text="ART-NET SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeText2}" Margin="0 24 0 12" />
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="14">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Art-Net Universe" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ArtNetUniverse, Mode=TwoWay}" FontSize="13" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port, Mode=TwoWay}" FontSize="13" />
              </Grid>
              <TextBlock Text="Art-Net universes are 0-based (0–32767) — match the number your receiver expects."
                         FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText2}" Margin="0 10 0 0" />

              <!-- Art-Net 3: broadcast / fixed-IP destination -->
              <StackPanel IsVisible="{Binding ShowArtNetSettings}">
                <Grid ColumnDefinitions="120,*" Margin="0 16 0 0">
                  <TextBlock Grid.Column="0" Text="Destination IP" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
                  <TextBox Grid.Column="1" Text="{Binding Ip, Mode=TwoWay}" FontSize="13" />
                </Grid>
                <TextBlock Text="255.255.255.255 broadcasts to the whole network. Use a node's IP to target it directly."
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText2}" Margin="0 8 0 0" />
              </StackPanel>

              <!-- Art-Net 4: discovery + unicast, with manual fallback targets -->
              <StackPanel IsVisible="{Binding ShowArtNet4Settings}">
                <TextBlock Text="Manual targets" Foreground="{DynamicResource ThemeText1}" FontSize="12" Margin="0 16 0 6" />
                <TextBox Text="{Binding ManualTargets, Mode=TwoWay}" FontSize="13"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                <TextBlock Text="Nodes are discovered automatically and unicast to. Add IPs here (one per line) to also send to nodes that don't answer Art-Net polling."
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText2}" Margin="0 8 0 0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

    <!-- ============ Fixtures ============ -->
    <TabItem Header="Fixtures">
      <Grid ColumnDefinitions="250,*">

        <DockPanel Grid.Column="0" Background="{DynamicResource Panel-Bg}">
          <Border DockPanel.Dock="Bottom" Padding="8 6"
                  BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ThemeBorder0}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="themed" Content="+ Add Fixture…" Click="OnAddFixtureClick" Padding="10 5" FontSize="12" />
              <Button Classes="themed" Content="Remove" Command="{Binding RemoveFixtureCommand}" Padding="10 5" FontSize="12" />
            </StackPanel>
          </Border>
          <ListBox ItemsSource="{Binding Fixtures}" SelectedItem="{Binding SelectedFixture}"
                   Background="Transparent" BorderThickness="0" Padding="0 4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FixtureListItemViewModel">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" MinWidth="20"
                             FontFamily="Monospace" FontSize="14" Foreground="{DynamicResource ThemeText1}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource ThemeText0}" />
                    <TextBlock Text="{Binding PatchSummary}" FontSize="11" Foreground="{DynamicResource ThemeText2}" Margin="0 2 0 0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1"
                      IsVisible="{Binding SelectedFixture, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
          <StackPanel Margin="26 22">
            <TextBlock Text="{Binding SelectedFixture.Name}" FontSize="16" Foreground="{DynamicResource ThemeText0}" />
            <TextBlock Text="{Binding SelectedFixture.TypeName}" FontSize="12" Foreground="{DynamicResource ThemeText2}" Margin="0 4 0 22" />

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Number" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFixture.Number, Mode=TwoWay}" FontSize="13" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedFixture.Name, Mode=TwoWay}" FontSize="13" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedFixture.TypeName}" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText0}" FontSize="13" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Universe" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding UniverseNumbers}"
                        SelectedItem="{Binding SelectedFixture.UniverseNumber, Mode=TwoWay}" FontSize="13" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Address" VerticalAlignment="Center" Foreground="{DynamicResource ThemeText1}" FontSize="12" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedFixture.Address, Mode=TwoWay}" FontSize="13" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </TabItem>

  </TabControl>
</Window>
