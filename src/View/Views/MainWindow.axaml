<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ViewModel"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:View"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="View.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="Luminary [dev]"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="600">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <!-- Blackout toggle: neutral when off, red when active -->
    <Style Selector="ToggleButton.blackout">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText0}" />
    </Style>
    <Style Selector="ToggleButton.blackout /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Button-Bg}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ToggleButton.blackout:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Button-Hover}" />
    </Style>
    <Style Selector="ToggleButton.blackout:checked">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.blackout:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C0392B" />
    </Style>
    <Style Selector="ToggleButton.blackout:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#D9503E" />
    </Style>

    <!-- Workspace tabs: compact strip that sits flush under the menu bar -->
    <Style Selector="TabControl.workspace">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabControl.workspace TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14 0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeText2}" />
    </Style>
    <Style Selector="TabControl.workspace TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText0}" />
    </Style>
    <Style Selector="TabControl.workspace TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource ListItem-Hover}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu bar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource PanelHeader-Bg}"
            BorderThickness="0 0 0 1"
            BorderBrush="{DynamicResource ThemeBorder0}">
      <DockPanel>
        <ToggleButton DockPanel.Dock="Right" Classes="blackout" Content="Blackout"
                      IsChecked="{Binding Blackout, Mode=TwoWay}"
                      Margin="6 4" Padding="14 3" FontSize="12" VerticalAlignment="Center" />
        <Menu Background="Transparent" BorderThickness="0">
          <MenuItem Header="File">
            <MenuItem Header="New" Click="OnNewClick" />
            <MenuItem Header="Open…" Click="OnOpenClick" />
            <Separator />
            <MenuItem Header="Save" Click="OnSaveClick" />
            <MenuItem Header="Save As…" Click="OnSaveAsClick" />
          </MenuItem>
          <MenuItem Header="Patch" Click="OnPatchClick" />
          <MenuItem Header="Macros" Click="OnMacrosClick" />
          <MenuItem Header="Bindings" Click="OnBindingsClick" />
          <MenuItem Header="MIDI" Click="OnMidiClick" />
        </Menu>
      </DockPanel>
    </Border>

    <!-- Workspace tabs -->
    <TabControl Classes="workspace" Background="{DynamicResource ThemeBg0}">
      <TabItem Header="Program">
        <views:ProgramView />
      </TabItem>
      <!-- Temporary home for the effects + macros panels until their own tab is defined. -->
      <TabItem Header="Effects">
        <Grid Background="{DynamicResource ThemeBg0}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource Panel-Bg}">
            <views:EffectsPanel DataContext="{Binding EffectsPanel}"/>
          </Border>
          <GridSplitter Classes="themed vertical" Grid.Column="1" />
          <Border Grid.Column="2" Background="{DynamicResource Panel-Bg}">
            <views:MacroTriggersPanel DataContext="{Binding MacrosPanel}"/>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
