<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ViewModel"
             xmlns:views="clr-namespace:View"
             x:Class="View.ColorCapabilityEditor"
             x:DataType="vm:ColorCapabilityViewModel">

  <Border Background="{DynamicResource ListItem-Bg}"
          CornerRadius="6"
          Padding="10 8"
          Margin="0 4">
    <Grid RowDefinitions="Auto,*">
      <TextBlock Grid.Row="0"
                 Text="{Binding Name}"
                 Foreground="{DynamicResource ThemeText2}"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Margin="0 0 0 8" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
        <views:LevelFader DataContext="{Binding Red}"   Label="R" Accent="#E5484D" VerticalAlignment="Stretch" />
        <views:LevelFader DataContext="{Binding Green}" Label="G" Accent="#46C265" VerticalAlignment="Stretch" />
        <views:LevelFader DataContext="{Binding Blue}"  Label="B" Accent="#4D8CFF" VerticalAlignment="Stretch" />
      </StackPanel>
    </Grid>
  </Border>

</UserControl>
