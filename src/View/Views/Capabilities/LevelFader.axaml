<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="View.LevelFader">

  <Border Name="Track"
          Width="26"
          MinHeight="60"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Center"
          Background="{DynamicResource ThemeBg1}"
          CornerRadius="5"
          ClipToBounds="True"
          Cursor="Hand">
    <Panel>
      <Canvas>
        <!-- Manual level fill (Accent colour overrides this in code when the fader has one) -->
        <Rectangle Name="Fill" Fill="{DynamicResource ThemeBg4}" />
        <!-- Cue value being fed in -->
        <Rectangle Name="Indicator" Height="2" Fill="{DynamicResource ThemeSuccess}" />
        <!-- Manual thumb -->
        <Rectangle Name="Thumb" Height="3" Fill="{DynamicResource ThemeText0}" />
      </Canvas>
      <!-- Optional label shown inside the track (e.g. R / G / B) -->
      <TextBlock Name="LabelText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="11" FontWeight="Bold" Foreground="White" IsHitTestVisible="False" />
    </Panel>
  </Border>

</UserControl>
