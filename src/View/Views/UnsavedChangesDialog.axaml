<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="View.UnsavedChangesDialog"
        Title="Unsaved Changes"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg0}">

  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="You have unsaved changes"
               FontSize="14" FontWeight="SemiBold"
               Foreground="{DynamicResource ThemeText0}" />
    <TextBlock Text="Do you want to save them before continuing?"
               FontSize="12" TextWrapping="Wrap"
               Foreground="{DynamicResource ThemeText1}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 6 0 0">
      <Button Classes="themed" Content="Cancel" Click="OnCancel" Padding="14 7" FontSize="12" />
      <Button Classes="themed" Content="Don't Save" Click="OnDiscard" Padding="14 7" FontSize="12" />
      <Button Content="Save" Click="OnSave" Padding="16 7" FontSize="12"
              Background="{DynamicResource ThemeSuccess}" Foreground="White" />
    </StackPanel>
  </StackPanel>
</Window>
