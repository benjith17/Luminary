<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ViewModel"
        xmlns:model="using:Model"
        x:Class="View.AddFixtureDialog"
        x:DataType="vm:AddFixtureDialogViewModel"
        Title="Add Fixture"
        Width="760" Height="520"
        MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBg0}">

  <DockPanel Margin="16">
    <TextBox DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Search fixtures…"
             FontSize="13" Margin="0 0 0 12" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
      <Button Classes="themed" Content="Cancel" Click="OnCancel" Padding="14 7" FontSize="12" />
      <Button Content="Add" Click="OnAdd" IsEnabled="{Binding CanAdd}" Padding="18 7" FontSize="12"
              Background="{DynamicResource ThemeSuccess}" Foreground="White" />
    </StackPanel>

    <Grid ColumnDefinitions="1*,1*,1.5*">

      <!-- Column 1: manufacturers -->
      <DockPanel Grid.Column="0" Margin="0 0 6 0">
        <TextBlock DockPanel.Dock="Top" Text="MANUFACTURER" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeText2}" Margin="2 0 0 6" />
        <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder0}" CornerRadius="4">
          <ListBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="0 4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ManufacturerItem">
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource ThemeText0}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <!-- Column 2: fixtures (models) -->
      <DockPanel Grid.Column="1" Margin="6 0 6 0">
        <TextBlock DockPanel.Dock="Top" Text="FIXTURE" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeText2}" Margin="2 0 0 6" />
        <Border BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder0}" CornerRadius="4">
          <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                   DoubleTapped="OnModelDoubleTapped" Background="Transparent" BorderThickness="0" Padding="0 4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelItem">
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource ThemeText0}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <!-- Column 3: detail + mode selection -->
      <Border Grid.Column="2" Margin="6 0 0 0" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder0}"
              CornerRadius="4" Background="{DynamicResource Panel-Bg}">
        <ScrollViewer>
          <StackPanel Margin="18" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding DetailModel}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeText0}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DetailManufacturer}" FontSize="12"
                       Foreground="{DynamicResource ThemeText2}" Margin="0 3 0 0" />

            <TextBlock Text="MODE" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeText2}" Margin="0 22 0 6" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" FontSize="13">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="model:FixtureDefinition">
                  <TextBlock Text="{Binding Mode}" FontSize="13" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{Binding DetailChannels}" FontSize="12"
                       Foreground="{DynamicResource ThemeText1}" Margin="0 14 0 0" />

            <TextBlock Text="CONTROLS" FontSize="10" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeText2}" Margin="0 18 0 6" />
            <ItemsControl ItemsSource="{Binding DetailCapabilities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource ThemeText0}" Margin="0 2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hidden entirely for a clean personality, so warnings read as exceptional. -->
            <StackPanel IsVisible="{Binding HasWarnings}">
              <TextBlock Text="WARNINGS" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ThemeWarning}" Margin="0 18 0 6" />
              <ItemsControl ItemsSource="{Binding DetailWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0 2"
                               Foreground="{DynamicResource ThemeWarning}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

    </Grid>
  </DockPanel>
</Window>
