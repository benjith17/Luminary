<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:luminary:fixture:1"
           targetNamespace="urn:luminary:fixture:1"
           elementFormDefault="qualified">

  <!-- Crossfade behaviour. Omit to take the capability type's default: pan/tilt snaps so the rig
       does not sweep on cue recall, everything else fades. Set snap on indexed values - a colour
       or gobo wheel, a shutter - so a crossfade does not run through every intervening slot. -->
  <xs:simpleType name="fadeBehavior">
    <xs:restriction base="xs:string">
      <xs:enumeration value="fade" />
      <xs:enumeration value="snap" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="idSegment">
    <xs:restriction base="xs:string"><xs:pattern value="[a-z0-9]+(-[a-z0-9]+)*" /></xs:restriction>
  </xs:simpleType>

  <!-- Generic channels: valid in any family. -->
  <xs:element name="level">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="channel" type="xs:positiveInteger" use="required" />
      <xs:attribute name="default" type="xs:unsignedByte" default="0" />
    </xs:complexType>
  </xs:element>
  <xs:element name="levelFine">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="channel" type="xs:positiveInteger" use="required" />
      <xs:attribute name="fine" type="xs:positiveInteger" use="required" />
      <xs:attribute name="default" type="xs:unsignedShort" default="0" />
    </xs:complexType>
  </xs:element>

  <!-- Intensity-only. -->
  <xs:element name="dimmer">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="channel" type="xs:positiveInteger" use="required" />
      <xs:attribute name="default" type="xs:unsignedByte" default="0" />
    </xs:complexType>
  </xs:element>
  <xs:element name="dimmerFine">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="channel" type="xs:positiveInteger" use="required" />
      <xs:attribute name="fine" type="xs:positiveInteger" use="required" />
      <xs:attribute name="default" type="xs:unsignedShort" default="0" />
    </xs:complexType>
  </xs:element>

  <!-- Color-only. Renamed from <color>, which would now clash with the family. -->
  <xs:element name="rgb">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="red" type="xs:positiveInteger" use="required" />
      <xs:attribute name="green" type="xs:positiveInteger" use="required" />
      <xs:attribute name="blue" type="xs:positiveInteger" use="required" />
      <xs:attribute name="defaultRed" type="xs:unsignedByte" default="0" />
      <xs:attribute name="defaultGreen" type="xs:unsignedByte" default="0" />
      <xs:attribute name="defaultBlue" type="xs:unsignedByte" default="0" />
    </xs:complexType>
  </xs:element>

  <!-- Focus-only. -->
  <xs:element name="panTilt">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="pan" type="xs:positiveInteger" use="required" />
      <xs:attribute name="tilt" type="xs:positiveInteger" use="required" />
      <xs:attribute name="defaultPan" type="xs:unsignedByte" default="0" />
      <xs:attribute name="defaultTilt" type="xs:unsignedByte" default="0" />
    </xs:complexType>
  </xs:element>
  <xs:element name="panTiltFine">
    <xs:complexType>
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="primary" type="xs:boolean" default="false" />
      <xs:attribute name="fade" type="fadeBehavior" />
      <xs:attribute name="pan" type="xs:positiveInteger" use="required" />
      <xs:attribute name="panFine" type="xs:positiveInteger" use="required" />
      <xs:attribute name="tilt" type="xs:positiveInteger" use="required" />
      <xs:attribute name="tiltFine" type="xs:positiveInteger" use="required" />
      <xs:attribute name="defaultPan" type="xs:unsignedShort" default="0" />
      <xs:attribute name="defaultTilt" type="xs:unsignedShort" default="0" />
    </xs:complexType>
  </xs:element>

  <!-- Families: each admits its own capability types, generic levels, and plug-ins. -->
  <xs:group name="generic">
    <xs:choice>
      <xs:element ref="level" />
      <xs:element ref="levelFine" />
      <xs:any namespace="##other" processContents="lax" />
    </xs:choice>
  </xs:group>

  <xs:element name="intensity">
    <xs:complexType><xs:choice maxOccurs="unbounded">
      <xs:element ref="dimmer" /><xs:element ref="dimmerFine" /><xs:group ref="generic" />
    </xs:choice></xs:complexType>
  </xs:element>
  <xs:element name="color">
    <xs:complexType><xs:choice maxOccurs="unbounded">
      <xs:element ref="rgb" /><xs:group ref="generic" />
    </xs:choice></xs:complexType>
  </xs:element>
  <xs:element name="focus">
    <xs:complexType><xs:choice maxOccurs="unbounded">
      <xs:element ref="panTilt" /><xs:element ref="panTiltFine" /><xs:group ref="generic" />
    </xs:choice></xs:complexType>
  </xs:element>
  <xs:element name="beam">
    <xs:complexType><xs:choice maxOccurs="unbounded">
      <xs:group ref="generic" />
    </xs:choice></xs:complexType>
  </xs:element>

  <xs:element name="mode">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="intensity" minOccurs="0" />
        <xs:element ref="color" minOccurs="0" />
        <xs:element ref="focus" minOccurs="0" />
        <xs:element ref="beam" minOccurs="0" />
      </xs:sequence>
      <xs:attribute name="id" type="idSegment" use="required" />
      <xs:attribute name="name" type="xs:string" use="required" />
      <xs:attribute name="channelCount" type="xs:positiveInteger" use="required" />
    </xs:complexType>
  </xs:element>

  <xs:element name="fixture">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="manufacturer" type="xs:string" />
        <xs:element name="model" type="xs:string" />
        <xs:element name="author" type="xs:string" minOccurs="0" />
        <xs:element name="created" type="xs:date" minOccurs="0" />
        <xs:element ref="mode" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
